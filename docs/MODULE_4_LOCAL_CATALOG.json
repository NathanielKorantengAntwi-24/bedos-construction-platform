  "policies": [
    {
      "name": "Administrators can delete properties",
      "roles": [
        "authenticated"
      ],
      "command": "DELETE",
      "using": "(get_user_role() = 'administrator'::text)",
      "check": null
    },
    {
      "name": "Property managers can create properties",
      "roles": [
        "authenticated"
      ],
      "command": "INSERT",
      "using": null,
      "check": "(get_user_role() = ANY (ARRAY['administrator'::text, 'content_manager'::text]))"
    },
    {
      "name": "Property managers can update properties",
      "roles": [
        "authenticated"
      ],
      "command": "UPDATE",
      "using": "(get_user_role() = ANY (ARRAY['administrator'::text, 'content_manager'::text]))",
      "check": "(get_user_role() = ANY (ARRAY['administrator'::text, 'content_manager'::text]))"
    },
    {
      "name": "Property managers can view all properties",
      "roles": [
        "authenticated"
      ],
      "command": "SELECT",
      "using": "(get_user_role() = ANY (ARRAY['administrator'::text, 'content_manager'::text]))",
